# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Data and models are tracked by DVC (backed up to D:\dvc-store\sanad-ml), never by git.
# DVC writes .gitignore entries next to every output it tracks; git only keeps the small
# .dvc / dvc.lock pointer files. Partial downloads and scratch output never get committed:
*.part
/runs/
/tmp/
# Downloads are never committed, even before `dvc add` (licences: e.g. the Oxford weights).
# Only DVC's small pointer files and its own .gitignore files go into git.
/data/raw/*
!/data/raw/*.dvc
!/data/raw/.gitignore
/data/interim/*
!/data/interim/.gitignore
/data/processed/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
